ENV=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/withcare
# Supabase 프로젝트 생성 후 채움 (인프라로만 사용 — docs/03-dev-plan.md 경계 룰)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# P7: 독촉·리마인드 스케줄러 (매일 09:00 독촉, 일 18:00 보드 리마인드 — KST)
SCHEDULER_ENABLED=true
# P11: CORS 허용 오리진 (쉼표 구분) — prod 배포 시 실제 도메인으로
CORS_ORIGINS=http://localhost:8081
# 본인인증 수단 (I1 관문): stub | email | phone
# phone은 Supabase에 SMS 제공자(Twilio 등) 설정 후에만 켠다
IDENTITY_METHOD=stub
# 네이버 로그인 (Supabase 미지원 → 자체 처리). 없으면 기능 자체가 꺼짐
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 자체 발급 JWT 서명 키 — 네이버 경로 전용. 32바이트 이상 랜덤
JWT_SECRET=
# 소셜 로그인 후 돌아갈 웹 주소
WEB_ORIGIN=http://localhost:8081
