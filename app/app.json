{
  "expo": {
    "name": "with-care",
    "slug": "with-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeobang.withcare",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "with-care",
        "NSPhotoLibraryUsageDescription": "돌봄 중 사진을 모임에 공유하기 위해 사진 보관함에 접근합니다.",
        "NSCameraUsageDescription": "돌봄 중 사진을 찍어 모임에 공유하기 위해 카메라를 사용합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yeobang.withcare",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "withcare",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "돌봄 중 사진을 모임에 공유하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "돌봄 중 사진을 찍어 모임에 공유하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4FB79A"
        }
      ]
    ]
  }
}
